# ProspectIQ server settings. Copy to .env and fill in.

# Port the Node server listens on (Hostinger passes its own; leave unset there)
PORT=3000

# Admin panel password. Open /admin and enter it.
ADMIN_KEY=change-me

# Where client data lives (clients, finders, usage logs). Must be writable.
DATA_DIR=./data

# Agency-level keys, used by any client that has no key of its own.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
APOLLO_API_KEY=
# Google Maps Platform key with "Places API (New)" enabled: the Local businesses tab. Can also be set in the admin Settings page
GOOGLE_MAPS_KEY=
# SerpAPI key: alternative source for the same tab, used only when no Google key is set
SERPAPI_KEY=

# Launchpad (white-labelled GoHighLevel) app URL used for "open in Launchpad" links
LAUNCHPAD_APP_URL=https://app.launchpadinnovations.ai

# Public URL of this app, used to build the menu-link URLs shown in the admin panel.
# Include the prefix when BASE_PATH is set, e.g. https://js.example.com/prospectiq
PUBLIC_URL=http://localhost:3000

# Serve the whole app under a path prefix (blank = the domain root). Used when the app
# shares a domain with other apps behind nginx: BASE_PATH=/prospectiq
BASE_PATH=
